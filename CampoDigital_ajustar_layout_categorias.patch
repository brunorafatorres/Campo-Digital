diff --git a/campodigital-backend/public/app.js b/campodigital-backend/public/app.js
--- a/campodigital-backend/public/app.js
+++ b/campodigital-backend/public/app.js
@@ -300,2 +300,12 @@
-    const existing = new Set(state.categories.map((item) => `${item.tipo}:${item.nombre.toLocaleLowerCase('pt-BR')}`));
-    const suggestions = (result.categorias || []).filter((item) => !existing.has(`${item.tipo}:${item.nombre.toLocaleLowerCase('pt-BR')}`));
+    const categoryKey = (item) => {
+      const name = typeof item?.nombre === 'string' ? item.nombre.trim() : '';
+      const type = typeof item?.tipo === 'string' ? item.tipo.trim().toUpperCase() : '';
+      return name && ['INGRESO', 'GASTO'].includes(type)
+        ? `${type}:${name.toLocaleLowerCase('pt-BR')}`
+        : null;
+    };
+    const existing = new Set(state.categories.map(categoryKey).filter(Boolean));
+    const suggestions = (Array.isArray(result.categorias) ? result.categorias : []).filter((item) => {
+      const key = categoryKey(item);
+      return key && !existing.has(key);
+    });
@@ -309,1 +319,5 @@
-    status.textContent = suggestions.length ? result.mensagem : 'As sugestões para essa produção já estão cadastradas.';
+    status.textContent = suggestions.length
+      ? (typeof result.mensagem === 'string' && result.mensagem.trim()
+        ? result.mensagem
+        : 'Revise as sugestões antes de adicioná-las às suas categorias.')
+      : 'As sugestões para essa produção já estão cadastradas.';
diff --git a/campodigital-backend/public/styles.css b/campodigital-backend/public/styles.css
--- a/campodigital-backend/public/styles.css
+++ b/campodigital-backend/public/styles.css
@@ -323,1 +323,34 @@
 .alerts-page{padding:26px}.notification-list{display:grid;gap:12px}.notification-item{display:grid;gap:5px;padding:16px;border:1px solid var(--line);border-radius:14px;background:white}.notification-item p{margin:4px 0 0;color:var(--muted);line-height:1.5}.notification-item small{color:var(--muted)}
+
+/* Cartão de recomendações na tela Categorias */
+.category-ai-card {
+  display: grid;
+  gap: 16px;
+  margin-top: 18px;
+  padding: 26px;
+}
+
+.category-ai-card .eyebrow { margin-bottom: 8px; }
+.category-ai-card > div:first-child > p:last-child {
+  margin: 8px 0 0;
+  color: var(--muted);
+  line-height: 1.55;
+}
+.category-ai-card > .field { margin: 0; }
+.category-ai-card .button-row { margin-top: 0; }
+.category-ai-card #category-ai-status {
+  min-height: 20px;
+  margin: 0;
+  color: var(--muted);
+  font-size: 13px;
+  line-height: 1.5;
+}
+.category-ai-card #category-ai-status:empty,
+.category-ai-card .suggestion-list:empty { display: none; }
+.category-ai-card > .primary-button.fit { justify-self: start; }
+
+@media (max-width: 620px) {
+  .category-ai-card { padding: 20px; }
+  .category-ai-card .button-row > button,
+  .category-ai-card > .primary-button.fit { width: 100%; }
+}
