DB_CONNECTION_LIMIT=10

# Use uma sequência aleatória longa. Não compartilhe o valor real nem o envie ao Git.
AUTH_TOKEN_SECRET=change_this_for_a_long_random_secret
AUTH_TOKEN_TTL_SECONDS=28800

# Serviço auxiliar Python/TensorFlow. O sistema financeiro funciona sem ele.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_TIMEOUT_MS=2500
